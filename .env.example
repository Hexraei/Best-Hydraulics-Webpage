# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# ─── Email delivery (Resend) ────────────────────────────────────────────────
# Free tier: 3,000 emails/month, no card required. https://resend.com
# 1. Sign up, go to API Keys, create a key with "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where quote requests are delivered. Comma-separate for multiple recipients.
RFQ_TO_EMAIL=besthydraulicss@gmail.com

# The "From" address. Leave the default until a domain is verified in Resend.
# NOTE: with onboarding@resend.dev, Resend only delivers to the email address
# that owns the Resend account. Verify a domain to send to any inbox.
RFQ_FROM_EMAIL=Best Hydraulics <onboarding@resend.dev>

# ─── WhatsApp alerts (CallMeBot) ────────────────────────────────────────────
# Free and permanent. https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1. Save +34 684 783 347 as a contact on the owner's phone.
# 2. From the owner's WhatsApp, send it: I allow callmebot to send me messages
# 3. The bot replies with an API key. Paste it below.
# Phone must include the country code, digits only (91 = India).
CALLMEBOT_PHONE=919363129869
CALLMEBOT_APIKEY=

# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Provision: Vercel Dashboard → Storage → Create → Neon (free tier).
# Then either copy the connection string here, or run:
#   vercel link && vercel env pull .env.local
# Create the tables with: npm run db:push
DATABASE_URL=

# ─── Image storage (Vercel Blob) ────────────────────────────────────────────
# Provision: Vercel Dashboard → Storage → Create → Blob.
# Product images uploaded in /admin are stored here.
BLOB_READ_WRITE_TOKEN=

# ─── Admin area (/admin) ────────────────────────────────────────────────────
# Login for the product manager. Defaults to the business email if unset.
ADMIN_EMAIL=alfaruberss@gmail.com
# The only credential protecting product editing. Use a strong passphrase in
# production — /admin is publicly reachable and anyone who guesses this can
# edit prices and delete the catalog.
ADMIN_PASSWORD=

# ─── Site ───────────────────────────────────────────────────────────────────
# Used for sitemap, robots.txt, and OpenGraph absolute URLs.
NEXT_PUBLIC_SITE_URL=https://besthydraulics.online
